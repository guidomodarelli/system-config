#compdef cx

# Completion for cx
# Supports:
#   update (as first positional)
#   -m <model>
#   -re <reasoning>
# Remaining args treated as query tokens.

: "${CX_FZF_HEIGHT:=20%}"   # Altura de fzf (override: export CX_FZF_HEIGHT=40%)

_cx_models() {
  echo "gpt-5
gpt-5-codex"
}

_cx_reasoning() {
  echo "high
medium
low"
}

_cx_model_select() {
  local -a items
  items=($(_cx_models))
  if (( $+commands[fzf] )); then
    local sel
    sel=$(printf '%s\n' "${items[@]}" | fzf --no-multi --height "${CX_FZF_HEIGHT}" --layout=reverse --border --prompt="Modelo> " --exit-0 --select-1 --query="${PREFIX}")
    if [[ -n $sel ]]; then
      compadd -- "$sel"
      return 0
    fi
  fi
  compadd -a items
}

_cx_reasoning_select() {
  local -a items
  items=($(_cx_reasoning))
  if (( $+commands[fzf] )); then
    local sel
    sel=$(printf '%s\n' "${items[@]}" | fzf --no-multi --height "${CX_FZF_HEIGHT}" --layout=reverse --border --prompt="Reasoning> " --exit-0 --select-1 --query="${PREFIX}")
    if [[ -n $sel ]]; then
      compadd -- "$sel"
      return 0
    fi
  fi
  compadd -a items
}

_cx() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  # Primera posición: siempre tratada como estado 'first' (para sugerir 'update')
  _arguments -C \
    '1:first arg:->first' \
    '-m[Model to use]:model:_cx_model_select' \
    '-re[Reasoning effort]:effort:_cx_reasoning_select' \
    '*:query token:' && return 0

  case $state in
    first)
      # Sugerir 'update'; si el usuario ya escribió algo, se filtra automáticamente.
      compadd update
      return 0
      ;;
  esac
}

_cx "$@"
