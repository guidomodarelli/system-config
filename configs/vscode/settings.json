{
  /* ======================================================================== */
  /*                                APARIENCIA                                */
  /* ======================================================================== */
  "workbench.colorTheme": "One Dark Pro Mix",
  "workbench.iconTheme": "catppuccin-perfect-ayu",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.colorCustomizations": {
    // // Texto insertado/eliminado (nivel carácter)
    "diffEditor.insertedTextBackground": "#00C84640",
    "diffEditor.removedTextBackground":  "#FF003C40"
  },
  "oneDarkPro.editorTheme": "One Dark Pro Darker",
  "oneDarkPro.bold": true,
  "oneDarkPro.vivid": true,
  "oneDarkPro.italic": true,
  "breadcrumbs.symbolPath": "off",

  /* ----------------------------- Workbench/Window ----------------------------- */
  "workbench.localHistory.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "top",
  "workbench.list.smoothScrolling": true,
  "workbench.list.horizontalScrolling": true,
  "workbench.tree.indent": 20,
  "workbench.tree.enableStickyScroll": true,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.enablePreview": false,
  "workbench.panel.showLabels": false,
  "workbench.browser.openLocalhostLinks": true,
  "window.titleBarStyle": "custom",
  "window.customTitleBarVisibility": "auto",
  "window.menuBarVisibility": "visible",
  "window.newWindowProfile": "Agents",
  "window.title": "${rootNameShort}${separator}${activeEditorShort}",

  /* ======================================================================== */
  /*                                   EDITOR                                  */
  /* ======================================================================== */
  "editor.fontFamily": "'Dank Mono', 'JetBrains Mono', 'IosevkaTerm NF', monospace", //
  "editor.fontLigatures": true,
  "editor.fontVariations": true,
  "editor.fontWeight": "normal",
  "editor.fontSize": 12,
  "editor.lineHeight": 1.7,
  "editor.tabSize": 2,
  "editor.rulers": [80, 120],
  "editor.wordWrapColumn": 120,
  "editor.wordWrap": "off",
  "editor.wrappingStrategy": "simple",
  "editor.wrapOnEscapedLineFeeds": true,
  "editor.wrappingIndent": "none",
  "editor.showUnused": true,
  "editor.renderWhitespace": "boundary",
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.linkedEditing": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.suggest.showVariables": true,
  "editor.suggest.showProperties": true,
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "inline",
  "editor.detectIndentation": true,
  "editor.scrollbar.vertical": "hidden",
  "editor.minimap.showSlider": "always",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.matchBrackets": "never",
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "[One Dark Pro]": {
      "rules": {
        "class": { "bold": true }
      }
    }
  },
  "editor.occurrencesHighlight": "multiFile",
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.accessibilitySupport": "off",
  "emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",

  /* ------------------------------ Inline Suggest ----------------------------- */
  "editor.inlineSuggest.showToolbar": "always",
  "editor.inlineSuggest.edits.renderSideBySide": "never",
  "editor.inlineSuggest.edits.showCollapsed": true,

  /* --------------------------------- Zen Mode --------------------------------- */
  "zenMode.hideLineNumbers": false,
  "zenMode.showTabs": "single",
  "zenMode.fullScreen": true,
  "zenMode.hideActivityBar": true,
  "zenMode.hideStatusBar": true,
  "zenMode.restore": true,
  "zenMode.silentNotifications": true,
  "zenMode.centerLayout": false,

  /* ======================================================================== */
  /*                                  TERMINAL                                 */
  /* ======================================================================== */
  "terminal.integrated.fontFamily": "'Dank Mono', 'JetBrains Mono NL', 'JetBrains Mono', 'IosevkaTerm NF', 'Cascadia Code', 'Fira Code', 'Droid Sans Fallback', monospace",
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.env.linux": {},
  "terminal.integrated.env.windows": {},
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.shellIntegration.history": 10000,
  "powershell.promptToUpdatePowerShell": false,

  /* ======================================================================== */
  /*                               EXPLORER/FILES                              */
  /* ======================================================================== */
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.autoReveal": "focusNoScroll",
  "files.eol": "\n",
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "*.sass": "sass",
    ".env_cluster": "dotenv",
    ".helmignore": "dotenv",
    "*.lock": "yaml",
    "*.css": "tailwindcss",
    ".env.production": "properties",
    ".env.local": "properties",
    ".env": "properties",
    "settings.json": "jsonc"
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.angular/*/**": true,
    "**/node_modules/*/**": true,
    "**/.pytest_cache/*/**": true,
    "**/dist/*/**": true
  },
  "search.exclude": {
    "**/mocks/**": true
  },

  /* ======================================================================== */
  /*                          LINT, FORMATO Y VALIDACIÓN                        */
  /* ======================================================================== */
  /* ESLint */
  "eslint.enable": true,
  "eslint.format.enable": true,
  "eslint.codeActionsOnSave.mode": "all",
  "eslint.run": "onType",
  "eslint.codeAction.showDocumentation": { "enable": true },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "svelte",
    "vue",
    "html",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "toml"
  ],
  "eslint.options": {
    "extensions": [
      ".ts",
      ".js",
      ".tsx",
      ".jsx",
      ".svelte",
      ".vue",
      ".json",
      ".jsonc",
      ".json5",
      ".html",
      ".yaml",
      ".yml",
      ".toml"
    ]
  },

  /* Linters */
  "css.lint.unknownAtRules": "ignore",
  "css.completion.triggerPropertyValueCompletion": true,
  "css.completion.completePropertyWithSemicolon": true,
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "rewrap.wrappingColumn": 80,

  /* ======================================================================== */
  /*                               JS/TS PREFERENCIAS                          */
  /* ======================================================================== */
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": false,
  "js/ts.inlayHints.variableTypes.enabled": false,
  "js/ts.inlayHints.propertyDeclarationTypes.enabled": false,
  "js/ts.preferences.quoteStyle": "double",
  "js/ts.suggest.paths": false,
  "js/ts.tsserver.web.typeAcquisition.enabled": true,
  "js/ts.preferences.importModuleSpecifier": "project-relative",
  "js/ts.preferences.importModuleSpecifierEnding": "minimal",
  "js/ts.preferences.jsxAttributeCompletionStyle": "braces",
  "js/ts.preferences.includePackageJsonAutoImports": "auto",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.useAliasesForRenames": true,
  "js/ts.suggest.jsdoc.enabled": true,
  "js/ts.suggest.autoImports": true,
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.referencesCodeLens.showOnAllFunctions": true,
  "js/ts.implementationsCodeLens.enabled": true,
  "js/ts.implementationsCodeLens.showOnInterfaceMethods": true,
  "js/ts.preferGoToSourceDefinition": true,
  "js/ts.tsserver.automaticTypeAcquisition.enabled": true,
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.inlayHints.enumMemberValues.enabled": true,

  /* ======================================================================== */
  /*                              CONTROL DE VERSIONES                          */
  /* ======================================================================== */
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  "git.allowNoVerifyCommit": true,
  "git.replaceTagsWhenPull": true,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": true,

  /* ======================================================================== */
  /*                                   CHAT/AI                                 */
  /* ======================================================================== */
  "chat.checkpoints.showFileChanges": true,
  "chat.agent.maxRequests": 5000,
  "chat.useHooks": true,
  "chat.useNestedAgentsMdFiles": true,
  "chat.mcp.gallery.enabled": true,
  "chat.editing.autoAcceptDelay": 1,
  "chat.extensionUnification.enabled": true,
  "chat.useAgentSkills": true,
  "chat.viewSessions.orientation": "stacked",
  "chat.permissions.default": "autoApprove",
  "chat.agentSkillsLocations": {
    "~/.codex/skills": true
  },
  "inlineChat.affordance": "gutter",

  /* ------------------------------- Copilot/PR -------------------------------- */
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.customInstructionsInSystemMessage": true,
  "github.copilot.chat.organizationInstructions.enabled": false,
  "github.copilot.chat.organizationCustomAgents.enabled": false,
  "github.copilot.nextEditSuggestions.eagerness": "high",
  "githubPullRequests.hideViewedFiles": true,

  /* ------------------------------- GitLens (AI) ------------------------------ */
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Write commit messages in English using an imperative, concise title, preferably no longer than 72 characters. Follow Conventional Commits wording, but omit the type, scope, and prefix punctuation: write 'add user validation' instead of 'feat(auth): add user validation'. Do not include issue numbers or references. Start the title with a lowercase verb and do not end it with a period."
    },
    {
      "text": "Wrap function, method, variable, class, and other code identifier names in «…». Never use backticks for code formatting. Prefix every literal dollar sign in an identifier with exactly one backslash in the generated message; for example: «\\$var»."
    },
    {
      "text": "Always include a descriptive body after the title, separated by a blank line. Explain what changed and why, adding relevant implementation details and behavioral impacts when supported by the diff or provided context. Scale the detail to the complexity of the change. Do not merely repeat the title, list every modified file, or invent motivations, test results, or impacts. Use short paragraphs or bullets when they improve readability."
    },
    {
      "text": "Return only the commit title and body, without introductory text, surrounding quotation marks, or Markdown code fences."
    }
  ],
  "github.copilot.chat.reviewSelection.instructions": [
    { "file": "fileName" },
    {
      "text": "Review the code closely, focusing on potential bugs, performance issues, and clarity. Point out any apparent problems or code smells. Suggest improvements in terms of readability and patterns."
    }
  ],
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "typescript": true
  },
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.includeDocumentation": true,
  "githubPullRequests.fileListLayout": "tree",
  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.createOnPublishBranch": "ask",
  "githubPullRequests.terminalLinksHandler": "github",
  "githubPullRequests.codingAgent.uiIntegration": true,

  /* ======================================================================== */
  /*                                   DIFF/DBG                                */
  /* ======================================================================== */
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.experimental.showMoves": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.renderSideBySide": true,
  "debug.console.wordWrap": false,
  "debug.console.fontSize": 13,

  /* ======================================================================== */
  /*                                   EXTENSIONES                             */
  /* ======================================================================== */
  // Path Autocomplete
  "path-autocomplete.pathMappings": {
    "@": "${folder}/src",
    "@components": "${folder}/src/components",
    "@utils": "${folder}/src/utils",
    "@assets": "${folder}/src/assets",
    "src": "${folder}/src",
    "/images": "${folder}/public/images"
  },
  "path-autocomplete.includeExtension": true,
  "path-autocomplete.extensionOnImport": true,

  // Tailwind & CSS utils
  "tailwindCSS.experimental.classRegex": [
    "clsx`([^`]*)",
    "tw`([^`]*)",
    "/\\*\\s*tw\\s*\\*/\\s*`([^`]*)",
    ["tw.style\\(([^)]*)\\)", "'([^']*)'"]
  ],
  "tailwindCSS.classAttributes": ["class", "className", "ngClass", "tw"],

  // Otros
  "extensions.ignoreRecommendations": true,

  /* ======================================================================== */
  /*                           SEGURIDAD / REMOTO / DEV                        */
  /* ======================================================================== */
  "security.workspace.trust.untrustedFiles": "open",
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
  "remote.autoForwardPortsSource": "hybrid",
  "dev.containers.executeInWSL": true,
  "remote.SSH.remotePlatform": {
    "46.202.146.221": "linux",
    "192.168.5.243": "linux",
    "server-lcdc.tail4877e7.ts.net": "linux"
  },

  /* ======================================================================== */
  /*                                FORMATOS/OTROS                             */
  /* ======================================================================== */
  "json.maxItemsComputed": 50000,
  "redhat.telemetry.enabled": true,
  "docker.extension.enableComposeLanguageServer": false,

  /* ======================================================================== */
  /*                         OVERRIDES POR LENGUAJE                             */
  /* ======================================================================== */
  "[json]": {
    "editor.quickSuggestions": { "strings": true, "other": true },
    "editor.suggest.insertMode": "replace",
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
  },
  "[astro]": { "editor.defaultFormatter": "astro-build.astro-vscode" },
  "[python]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  }
}