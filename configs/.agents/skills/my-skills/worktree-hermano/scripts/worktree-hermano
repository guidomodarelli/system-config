#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME=$(basename "$0")

usage() {
  cat <<'EOF'
Uso:
  worktree-hermano create --branch BRANCH [--name NAME | --path PATH] [--dry-run]
  worktree-hermano create --branch BRANCH --confirm-primary-switch-to-develop
  worktree-hermano list
  worktree-hermano remove (--branch BRANCH | --path PATH) [--dry-run]
  worktree-hermano --help

Operaciones:
  create   Crea worktree hermano usando rama existente local o remota.
  list     Lista worktrees registrados sin modificar Git.
  remove   Remueve worktree hermano limpio sin borrar rama local.

Opciones create:
  --branch BRANCH                         Rama local, remote-tracking o ref completa.
  --name NAME                             Sufijo seguro para ruta hermana.
  --path PATH                             Ruta hermana explícita.
  --dry-run                               Valida y muestra operación sin ejecutarla.
  --confirm-primary-switch-to-develop     Autoriza mover principal limpio a develop.

Opciones remove:
  --branch BRANCH                         Rama checkout del worktree a remover.
  --path PATH                             Ruta del worktree a remover.
  --dry-run                               Valida y muestra operación sin ejecutarla.

Códigos:
  0  Operación exitosa, ayuda o dry-run válido.
  1  Error Git o runtime.
  2  Argumentos inválidos.
  3  Bloqueo de seguridad o confirmación requerida.
EOF
}

usage_error() {
  printf 'Uso inválido: %s\n' "$1" >&2
  printf 'Ejecutá %s --help para ver opciones.\n' "$SCRIPT_NAME" >&2
  exit 2
}

runtime_error() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

blocked_error() {
  printf 'Operación bloqueada: %s\n' "$1" >&2
  exit 3
}

require_option_value() {
  local option=$1
  local value=${2:-}
  if [[ -z "$value" || "$value" == -* ]]; then
    usage_error "falta valor para $option"
  fi
}

show_ref_exists() {
  git show-ref --verify --quiet "$1"
}

canonical_existing_path() {
  local path=$1
  (cd "$path" 2>/dev/null && pwd -P)
}

normalize_registered_path() {
  local path=$1
  local parent
  local name

  if [[ -d "$path" ]]; then
    canonical_existing_path "$path"
    return
  fi

  parent=$(dirname "$path")
  name=$(basename "$path")
  if [[ -d "$parent" ]]; then
    parent=$(canonical_existing_path "$parent") || return 1
    printf '%s/%s\n' "$parent" "$name"
  else
    printf '%s\n' "$path"
  fi
}

normalize_path_input() {
  local input=$1
  local candidate
  local parent
  local name

  case "$input" in
    /*) candidate=$input ;;
    *) candidate=$repository_root/$input ;;
  esac

  parent=$(dirname "$candidate")
  name=$(basename "$candidate")
  if [[ ! -d "$parent" ]]; then
    return 1
  fi
  parent=$(canonical_existing_path "$parent") || return 1
  printf '%s/%s\n' "$parent" "$name"
}

validate_path_component() {
  local value=$1
  if [[ "$value" == "." || "$value" == ".." ]]; then
    return 1
  fi
  if [[ ! "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    return 1
  fi
}

slugify_branch() {
  local branch_leaf=$1
  local slug

  slug=$(printf '%s' "$branch_leaf" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-')
  while [[ "$slug" == -* ]]; do
    slug=${slug#-}
  done
  while [[ "$slug" == *- ]]; do
    slug=${slug%-}
  done
  [[ -n "$slug" ]] || return 1
  printf '%s\n' "$slug"
}

reset_worktree_records() {
  worktree_paths=()
  worktree_branches=()
  worktree_heads=()
  worktree_detached=()
  worktree_locked=()
}

append_worktree_record() {
  local index
  if [[ -z "$current_worktree_path" ]]; then
    return 0
  fi

  index=${#worktree_paths[@]}
  worktree_paths[index]=$(normalize_registered_path "$current_worktree_path") || worktree_paths[index]=$current_worktree_path
  worktree_branches[index]=$current_worktree_branch
  worktree_heads[index]=$current_worktree_head
  worktree_detached[index]=$current_worktree_detached
  worktree_locked[index]=$current_worktree_locked
}

parse_worktrees() {
  local listing
  local line

  reset_worktree_records
  listing=$(git worktree list --porcelain 2>/dev/null) || runtime_error 'no se pudo leer git worktree list.'

  current_worktree_path=
  current_worktree_branch=
  current_worktree_head=
  current_worktree_detached=false
  current_worktree_locked=false

  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        append_worktree_record
        current_worktree_path=${line#worktree }
        current_worktree_branch=
        current_worktree_head=
        current_worktree_detached=false
        current_worktree_locked=false
        ;;
      HEAD\ *) current_worktree_head=${line#HEAD } ;;
      branch\ refs/heads/*) current_worktree_branch=${line#branch refs/heads/} ;;
      detached) current_worktree_detached=true ;;
      locked*) current_worktree_locked=true ;;
    esac
  done <<EOF
$listing
EOF

  append_worktree_record
}

find_branch_index() {
  local branch=$1
  local index
  branch_index=-1
  for index in "${!worktree_branches[@]}"; do
    if [[ "${worktree_branches[$index]}" == "$branch" ]]; then
      branch_index=$index
      return 0
    fi
  done
  return 0
}

find_path_index() {
  local path=$1
  local index
  path_index=-1
  for index in "${!worktree_paths[@]}"; do
    if [[ "${worktree_paths[$index]}" == "$path" ]]; then
      path_index=$index
      return 0
    fi
  done
  return 0
}

resolve_branch() {
  local input=$1
  local branch_name
  local remote_ref
  local remote_and_branch
  local remote_name
  local remote_branch
  local matches
  local match_count
  local match

  resolved_branch=
  resolved_remote_ref=
  local_branch_exists=false

  [[ -n "$input" ]] || return 1

  case "$input" in
    refs/heads/*)
      branch_name=${input#refs/heads/}
      git check-ref-format --branch "$branch_name" >/dev/null 2>&1 || return 1
      show_ref_exists "refs/heads/$branch_name" || return 1
      resolved_branch=$branch_name
      local_branch_exists=true
      return 0
      ;;
    refs/remotes/*)
      remote_and_branch=${input#refs/remotes/}
      remote_name=${remote_and_branch%%/*}
      remote_branch=${remote_and_branch#*/}
      [[ -n "$remote_name" && "$remote_branch" != "$remote_and_branch" ]] || return 1
      git check-ref-format --branch "$remote_branch" >/dev/null 2>&1 || return 1
      remote_ref="refs/remotes/$remote_name/$remote_branch"
      show_ref_exists "$remote_ref" || return 1
      resolved_branch=$remote_branch
      resolved_remote_ref=$remote_ref
      if show_ref_exists "refs/heads/$resolved_branch"; then
        local_branch_exists=true
        resolved_remote_ref=
            fi
      return 0
      ;;
  esac

  git check-ref-format --branch "$input" >/dev/null 2>&1 || return 1
  if show_ref_exists "refs/heads/$input"; then
    resolved_branch=$input
    local_branch_exists=true
    return 0
  fi

  if [[ "$input" == */* ]] && show_ref_exists "refs/remotes/$input"; then
    remote_and_branch=$input
    remote_name=${remote_and_branch%%/*}
    remote_branch=${remote_and_branch#*/}
    [[ -n "$remote_name" && "$remote_branch" != "$remote_and_branch" ]] || return 1
    resolved_branch=$remote_branch
    resolved_remote_ref="refs/remotes/$input"
    return 0
  fi

  matches=$(git for-each-ref --format='%(refname)' "refs/remotes/*/$input")
  match_count=0
  match=
  while IFS= read -r remote_ref; do
    [[ -n "$remote_ref" ]] || continue
    match_count=$((match_count + 1))
    match=$remote_ref
  done <<EOF
$matches
EOF

  if [[ "$match_count" -ne 1 ]]; then
    return 1
  fi

  remote_and_branch=${match#refs/remotes/}
  remote_name=${remote_and_branch%%/*}
  remote_branch=${remote_and_branch#*/}
  resolved_branch=$remote_branch
  resolved_remote_ref=$match
  return 0
}

path_is_registered() {
  local path=$1
  local index
  for index in "${!worktree_paths[@]}"; do
    if [[ "${worktree_paths[$index]}" == "$path" ]]; then
      return 0
    fi
  done
  return 1
}

worktree_is_clean() {
  local path=$1
  local include_ignored=${2:-false}
  local status_output

  if [[ "$include_ignored" == true ]]; then
    status_output=$(git -C "$path" status --porcelain=v1 --untracked-files=all --ignored 2>/dev/null) || return 1
  else
    status_output=$(git -C "$path" status --porcelain=v1 --untracked-files=all 2>/dev/null) || return 1
  fi
  [[ -z "$status_output" ]]
}

print_quoted_command() {
  local argument
  printf '  '
  for argument in "$@"; do
    printf '%q ' "$argument"
  done
  printf '\n'
}

print_tracking() {
  local path=$1
  local upstream
  if upstream=$(git -C "$path" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
    printf '%s\n' "$upstream"
  else
    printf '%s\n' 'sin upstream'
  fi
}

resolve_create_target() {
  local requested_name=$1
  local requested_path=$2
  local branch_leaf
  local branch_slug
  local repository_name

  source_parent=$(dirname "$repository_root")
  source_parent=$(canonical_existing_path "$source_parent") || runtime_error 'no se pudo resolver directorio padre.'
  repository_name=$(basename "$repository_root")

  if [[ -n "$requested_name" ]]; then
    validate_path_component "$requested_name" || usage_error "--name inválido: $requested_name"
    target_path="$source_parent/${repository_name}-${requested_name}"
  elif [[ -n "$requested_path" ]]; then
    target_path=$(normalize_path_input "$requested_path") || blocked_error "no se pudo resolver padre de --path: $requested_path"
  else
    branch_leaf=${resolved_branch##*/}
    branch_slug=$(slugify_branch "$branch_leaf") || runtime_error 'no se pudo construir slug de rama.'
    target_path="$source_parent/${repository_name}-${branch_slug}"
  fi

  target_parent=$(dirname "$target_path")
  target_name=$(basename "$target_path")
  validate_path_component "$target_name" || blocked_error "nombre final de ruta inseguro: $target_name"

  [[ "$target_parent" == "$source_parent" ]] || blocked_error "ruta debe ser hermana inmediata de $repository_root: $target_path"
  [[ "$target_path" != "$repository_root" ]] || blocked_error 'ruta destino coincide con worktree actual.'
  [[ ! -e "$target_path" && ! -L "$target_path" ]] || blocked_error "ruta destino ya existe: $target_path"
  if path_is_registered "$target_path"; then
    blocked_error "ruta ya está registrada en Git: $target_path"
  fi
  return 0
}

prepare_repository_context() {
  repository_root=$(git rev-parse --show-toplevel 2>/dev/null) || runtime_error 'no se encontró repositorio Git en directorio actual.'
  repository_root=$(canonical_existing_path "$repository_root") || runtime_error 'no se pudo resolver raíz del repositorio.'
  current_worktree=$repository_root
  parse_worktrees
  [[ "${#worktree_paths[@]}" -gt 0 ]] || runtime_error 'repositorio no tiene worktrees registrados.'
  primary_path=${worktree_paths[0]}
  find_path_index "$current_worktree"
  [[ "$path_index" -ge 0 ]] || runtime_error "worktree actual no aparece en lista Git: $current_worktree"
}

print_create_summary() {
  printf 'Rama solicitada: %s\n' "$resolved_branch"
  if [[ -n "$resolved_remote_ref" && "$local_branch_exists" == false ]]; then
    printf 'Origen: %s (tracking local se creará)\n' "$resolved_remote_ref"
  else
    printf 'Origen: rama local existente\n'
  fi
  printf 'Worktree actual: %s\n' "$current_worktree"
  printf 'Destino hermano: %s\n' "$target_path"
  if [[ "$switch_primary" == true ]]; then
    printf 'Cambio adicional: principal %s -> develop\n' "$primary_path"
  fi
}

create_worktree() {
  local branch_input=$1
  local requested_name=$2
  local requested_path=$3
  local dry_run=$4
  local confirm_primary_switch=$5
  local worktree_command

  [[ -n "$branch_input" ]] || usage_error 'create requiere --branch BRANCH'
  [[ -z "$requested_name" || -z "$requested_path" ]] || usage_error '--name y --path son mutuamente excluyentes.'
  [[ "$current_worktree" == "$primary_path" || "$confirm_primary_switch" == false ]] || blocked_error '--confirm-primary-switch-to-develop solo puede ejecutarse desde worktree principal.'

  resolve_branch "$branch_input" || usage_error "rama local o remote-tracking no encontrada o ambigua: $branch_input"
  resolve_create_target "$requested_name" "$requested_path"

  find_branch_index "$resolved_branch"
  switch_primary=false
  if [[ "$branch_index" -ge 0 ]]; then
    occupied_path=${worktree_paths[$branch_index]}
    if [[ "$occupied_path" != "$primary_path" ]]; then
      blocked_error "rama $resolved_branch ya está checkout en $occupied_path; no se moverá automáticamente."
    fi
    [[ "$confirm_primary_switch" == true ]] || blocked_error "rama $resolved_branch ya está checkout en principal $primary_path; requiere confirmación explícita para cambiar principal a develop."
    [[ "$current_worktree" == "$primary_path" ]] || blocked_error 'confirmación para mover principal requiere ejecutar desde worktree principal.'
    show_ref_exists refs/heads/develop || blocked_error 'rama local develop no existe; no se puede mover principal.'
    find_branch_index develop
    [[ "$branch_index" -lt 0 ]] || blocked_error "rama develop ya está checkout en ${worktree_paths[$branch_index]}."
    worktree_is_clean "$primary_path" || blocked_error 'principal tiene cambios no committeados o archivos no trackeados; no se moverá.'
    switch_primary=true
  elif [[ "$confirm_primary_switch" == true ]]; then
    printf 'Aviso: --confirm-primary-switch-to-develop no es necesario porque rama está libre.\n'
  fi

  print_create_summary
  if [[ -n "$resolved_remote_ref" && "$local_branch_exists" == false ]]; then
    worktree_command=(git worktree add --track -b "$resolved_branch" "$target_path" "$resolved_remote_ref")
  else
    worktree_command=(git worktree add "$target_path" "$resolved_branch")
  fi

  if [[ "$dry_run" == true ]]; then
    printf 'Dry-run: comandos previstos:\n'
    if [[ "$switch_primary" == true ]]; then
      print_quoted_command git -C "$primary_path" switch -- develop
    fi
    print_quoted_command "${worktree_command[@]}"
    return 0
  fi

  if [[ "$switch_primary" == true ]]; then
    printf 'Cambiando worktree principal a develop: %s\n' "$primary_path"
    if ! git -C "$primary_path" switch -- develop; then
      runtime_error 'no se pudo cambiar worktree principal a develop.'
    fi
  fi

  printf 'Creando worktree: %s\n' "$target_path"
  if ! "${worktree_command[@]}"; then
    if [[ "$switch_primary" == true ]]; then
      printf 'Advertencia: principal quedó en develop; creación de worktree falló.\n' >&2
    fi
    runtime_error 'git worktree add falló.'
  fi

  printf 'Worktree creado correctamente.\n'
  printf 'Ruta: %s\n' "$target_path"
  printf 'Rama: %s\n' "$resolved_branch"
  printf 'Upstream: %s\n' "$(print_tracking "$target_path")"
  printf 'HEAD: %s\n' "$(git -C "$target_path" rev-parse HEAD)"
}

list_worktrees() {
  local index
  local role
  local branch
  local status

  printf 'Worktrees registrados: %s\n' "${#worktree_paths[@]}"
  for index in "${!worktree_paths[@]}"; do
    role=hermano
    [[ "$index" -eq 0 ]] && role=principal
    [[ "${worktree_paths[$index]}" == "$current_worktree" ]] && role="$role/actual"
    branch=${worktree_branches[$index]}
    if [[ "${worktree_detached[$index]}" == true || -z "$branch" ]]; then
      branch=detached
    fi
    status=activo
    [[ -d "${worktree_paths[$index]}" ]] || status=stale
    [[ "${worktree_locked[$index]}" == true ]] && status="$status/locked"
    printf -- '- rol: %s\n' "$role"
    printf '  ruta: %s\n' "${worktree_paths[$index]}"
    printf '  rama: %s\n' "$branch"
    printf '  upstream: '
    if [[ "$status" == stale ]]; then
      printf '%s\n' 'no disponible'
    else
      print_tracking "${worktree_paths[$index]}"
    fi
    printf '  HEAD: %s\n' "${worktree_heads[$index]}"
    printf '  estado: %s\n' "$status"
  done
}

remove_worktree() {
  local branch_input=$1
  local requested_path=$2
  local dry_run=$3
  local target_path_to_remove
  local remove_command

  [[ -z "$branch_input" || -z "$requested_path" ]] || usage_error '--branch y --path son mutuamente excluyentes.'
  [[ -n "$branch_input" || -n "$requested_path" ]] || usage_error 'remove requiere --branch BRANCH o --path PATH.'

  if [[ -n "$branch_input" ]]; then
    if resolve_branch "$branch_input"; then
      target_branch=$resolved_branch
    else
      git check-ref-format --branch "$branch_input" >/dev/null 2>&1 || usage_error "rama inválida: $branch_input"
      target_branch=$branch_input
    fi
    find_branch_index "$target_branch"
    [[ "$branch_index" -ge 0 ]] || blocked_error "no existe worktree checkout con rama $target_branch."
    target_path_to_remove=${worktree_paths[$branch_index]}
  else
    target_path_to_remove=$(normalize_path_input "$requested_path") || blocked_error "no se pudo resolver --path: $requested_path"
    find_path_index "$target_path_to_remove"
    [[ "$path_index" -ge 0 ]] || blocked_error "path no está registrado como worktree: $target_path_to_remove"
    target_branch=${worktree_branches[$path_index]}
  fi

  find_path_index "$target_path_to_remove"
  [[ "$path_index" -gt 0 ]] || blocked_error 'no se permite remover worktree principal.'
  [[ "$target_path_to_remove" != "$current_worktree" ]] || blocked_error 'no se permite remover worktree desde sí mismo.'
  [[ -d "$target_path_to_remove" ]] || blocked_error "worktree stale o inexistente: $target_path_to_remove; no se ejecutará prune."
  worktree_is_clean "$target_path_to_remove" true || blocked_error "worktree tiene cambios o archivos ignorados: $target_path_to_remove"

  remove_command=(git worktree remove "$target_path_to_remove")
  printf 'Worktree seleccionado: %s\n' "$target_path_to_remove"
  printf 'Rama conservada: %s\n' "${target_branch:-detached}"

  if [[ "$dry_run" == true ]]; then
    printf 'Dry-run: comando previsto:\n'
    print_quoted_command "${remove_command[@]}"
    return 0
  fi

  if ! "${remove_command[@]}"; then
    runtime_error 'git worktree remove falló.'
  fi
  printf 'Worktree removido correctamente; rama local conservada.\n'
}

operation=${1:-}
if [[ "$operation" == '--help' || "$operation" == '-h' ]]; then
  usage
  exit 0
fi
[[ -n "$operation" ]] || usage_error 'falta operación.'
shift

branch_input=
requested_name=
requested_path=
dry_run=false
confirm_primary_switch=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --branch)
      require_option_value "$1" "${2:-}"
      branch_input=$2
      shift 2
      ;;
    --name)
      require_option_value "$1" "${2:-}"
      requested_name=$2
      shift 2
      ;;
    --path)
      require_option_value "$1" "${2:-}"
      requested_path=$2
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --confirm-primary-switch-to-develop)
      confirm_primary_switch=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage_error "opción desconocida: $1"
      ;;
  esac
done

case "$operation" in
  create)
    prepare_repository_context
    create_worktree "$branch_input" "$requested_name" "$requested_path" "$dry_run" "$confirm_primary_switch"
    ;;
  list)
    [[ -z "$branch_input" && -z "$requested_name" && -z "$requested_path" && "$dry_run" == false && "$confirm_primary_switch" == false ]] || usage_error 'list no acepta opciones de mutación.'
    prepare_repository_context
    list_worktrees
    ;;
  remove)
    [[ -z "$requested_name" && "$confirm_primary_switch" == false ]] || usage_error 'remove no acepta --name ni --confirm-primary-switch-to-develop.'
    prepare_repository_context
    remove_worktree "$branch_input" "$requested_path" "$dry_run"
    ;;
  *)
    usage_error "operación desconocida: $operation"
    ;;
esac
