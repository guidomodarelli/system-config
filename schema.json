{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$defs": {
    "platform": {
      "type": "string",
      "enum": ["darwin", "linux", "win32"]
    },
    "linuxDistro": {
      "type": "string",
      "enum": ["arch", "debian"],
      "description": "Linux distribution type",
      "$comment": "When this field is not present, it means that the configuration is applicable to all linux distributions"
    },
    "targetPath": {
      "type": "string",
      "description": "Target path for symlink."
    },
    "platformConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "linuxDistro": {
          "$ref": "#/$defs/linuxDistro"
        },
        "wsl": {
          "type": "boolean",
          "description": "Indicates whether this config is for WSL environments"
        }
      },
      "required": ["platform"],
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "enum": ["linux"]
              }
            }
          },
          "then": {
            "properties": {
              "linuxDistro": {
                "$ref": "#/$defs/linuxDistro"
              },
              "wsl": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "not": {
              "required": ["linuxDistro", "wsl"]
            }
          }
        }
      ]
    },
    "platformArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      },
      "uniqueItems": true
    },
    "platformConfigArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platformConfig"
      },
      "uniqueItems": true
    }
  },
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "unevaluatedProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/targetPath"
          },
          "onlyFor": {
            "$ref": "#/$defs/platformConfigArray"
          },
          "excludeFor": {
            "$ref": "#/$defs/platformConfigArray"
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "unevaluatedProperties": false,
              "allOf": [
                {
                  "$ref": "#/$defs/platformConfig"
                },
                {
                  "if": {
                    "properties": {
                      "platform": { "enum": ["linux"] },
                      "wsl": { "const": true }
                    },
                    "required": ["platform", "wsl"]
                  },
                  "then": {
                    "properties": {
                      "target": {
                        "type": "string",
                        "pattern": "^WSL://",
                        "description": "WSL environments must use WSL:// prefix"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "target": {
                        "type": "string",
                        "pattern": "^(?!WSL://)",
                        "description": "Non-WSL environments should not use WSL:// prefix"
                      }
                    }
                  }
                }
              ],
              "required": ["target"]
            }
          }
        },
        "required": ["path"]
      }
    }
  }
}
