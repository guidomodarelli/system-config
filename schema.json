{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$defs": {
    "platform": {
      "type": "string",
      "enum": ["darwin", "linux", "win32"],
      "description": "Operating system platform identifier"
    },
    "linuxDistro": {
      "type": "string",
      "enum": ["debian"],
      "description": "Linux distribution type (Debian/Ubuntu)",
      "$comment": "When this field is not present, it means that the configuration is applicable to all linux distributions"
    },
    "targetPath": {
      "type": "string",
      "description": "Target path for symlink."
    },
    "platformConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "description": "Configuration specific to a particular platform or environment",
      "properties": {
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "linuxDistro": {
          "$ref": "#/$defs/linuxDistro"
        },
        "wsl": {
          "type": "boolean",
          "description": "Indicates whether this config is for WSL environments"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "enum": ["linux"]
              }
            },
            "required": ["platform"]
          },
          "then": {
            "properties": {
              "linuxDistro": {
                "$ref": "#/$defs/linuxDistro"
              }
            }
          },
          "else": {
            "not": {
              "required": ["linuxDistro"]
            }
          }
        },
        {
          "oneOf": [
            {
              "required": ["platform"],
              "not": {
                "required": ["wsl"]
              }
            },
            {
              "required": ["wsl"],
              "not": {
                "required": ["platform"]
              }
            }
          ]
        }
      ]
    },
    "platformArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      },
      "uniqueItems": true,
      "description": "Array of platform identifiers"
    },
    "platformConfigArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platformConfig"
      },
      "uniqueItems": true,
      "description": "Array of platform-specific configurations"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "System configuration schema for managing symlinks across different platforms",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "paths": {
      "type": "array",
      "description": "Collection of path configurations for symlinking",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "unevaluatedProperties": false,
        "description": "Individual path configuration",
        "properties": {
          "path": {
            "type": "string",
            "description": "Source path for the symlink"
          },
          "target": {
            "$ref": "#/$defs/targetPath"
          },
          "onlyFor": {
            "$ref": "#/$defs/platformConfigArray",
            "description": "Restricts this path configuration to specific platforms or environments"
          },
          "excludeFor": {
            "$ref": "#/$defs/platformConfigArray",
            "description": "Excludes this path configuration from specific platforms or environments"
          },
          "overrides": {
            "type": "array",
            "description": "Platform-specific overrides for this path configuration",
            "items": {
              "type": "object",
              "unevaluatedProperties": false,
              "description": "Platform-specific override",
              "allOf": [
                {
                  "$ref": "#/$defs/platformConfig"
                },
                {
                  "if": {
                    "properties": {
                      "wsl": { "const": true }
                    },
                    "required": ["wsl"]
                  },
                  "then": {
                    "properties": {
                      "target": {
                        "type": "string",
                        "pattern": "^WSL://",
                        "description": "WSL environments must use WSL:// prefix"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "target": {
                        "type": "string",
                        "pattern": "^(?!WSL://)",
                        "description": "Non-WSL environments should not use WSL:// prefix"
                      }
                    }
                  }
                }
              ],
              "required": ["target"]
            }
          }
        },
        "required": ["path"],
        "allOf": [
          {
            "if": {
              "properties": {
                "onlyFor": {
                  "type": "array",
                  "maxItems": 1,
                  "minItems": 1,
                  "items": [
                    {
                      "type": "object",
                      "required": ["wsl"],
                      "properties": {
                        "wsl": { "const": true }
                      }
                    }
                  ]
                }
              },
              "required": ["onlyFor"]
            },
            "then": {
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^WSL://"
                }
              },
              "required": ["target"]
            }
          }
        ]
      }
    }
  }
}
