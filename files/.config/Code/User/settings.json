{
  "workbench.localHistory.enabled": false,
  "window.titleBarStyle": "custom",
  "editor.fontFamily": "'JetBrains Mono', 'IosevkaTerm NF','Dank Mono', monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.8,
  "editor.fontWeight": "normal",
  "editor.showUnused": true,
  "terminal.integrated.fontWeight": "bold",
  "editor.tabSize": 2,
  "editor.wrappingStrategy": "advanced",
  "editor.wordWrap": "off",
  "editor.wordWrapColumn": 80,
  "editor.rulers": [
    120
  ],
  "rewrap.wrappingColumn": 80,
  "editor.wrappingIndent": "deepIndent",
  "errorLens.fontSize": "12",
  "errorLens.fontWeight": "bold",
  "errorLens.severityText": [
    "ERROR",
    "WARNING",
    "INFO",
    "HINT"
  ],
  "errorLens.messageTemplate": "[$severity] $message",
  "typescript.preferences.quoteStyle": "double",
  "typescript.suggest.paths": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "explorer.confirmDragAndDrop": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "window.title": "${rootName}${separator}${activeEditorMedium}",
  "auto-close-tag.disableOnLanguage": [
    "typescript",
    "javascript"
  ],
  "terminal.integrated.tabs.enabled": true,
  "path-autocomplete.pathMappings": {
    "@": "${folder}/src",
    "@components": "${folder}/src/components",
    "@utils": "${folder}/src/utils",
    "@assets": "${folder}/src/assets",
    "src": "${folder}/src",
    "/images": "${folder}/public/images",
  },
  "path-autocomplete.includeExtension": true,
  "path-autocomplete.extensionOnImport": true,
  "oneDarkPro.editorTheme": "One Dark Pro Darker",
  "oneDarkPro.vivid": true,
  "redhat.telemetry.enabled": true,
  "json.maxItemsComputed": 50000,
  "go.toolsManagement.autoUpdate": true,
  "terminal.integrated.fontFamily": "'MesloLGM Nerd Font', monospace",
  // Config specific
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "editor.suggest.showVariables": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.angular/*/**": true,
    "**/node_modules/*/**": true,
    "**/.pytest_cache/*/**": true,
    "**/dist/*/**": true,
  },
  "editor.suggest.showProperties": true,
  "extensions.ignoreRecommendations": true,
  "color-highlight.markerType": "underline",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "files.associations": {
    "*.sass": "sass",
    ".env_cluster": "dotenv",
    ".helmignore": "dotenv",
    "*.lock": "yaml",
    "*.css": "scss",
    ".env.production": "properties",
    ".env.local": "properties",
    ".env": "properties"
  },
  "go.useLanguageServer": true,
  "editor.guides.bracketPairs": true,
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  /* -------------------------------------------------------------------------- */
  /*                                   ESLINT                                   */
  /* -------------------------------------------------------------------------- */
  "eslint.enable": true,
  "eslint.format.enable": true,
  "eslint.codeActionsOnSave.mode": "all",
  "eslint.run": "onType",
  "eslint.codeAction.showDocumentation": {
    "enable": true
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "svelte",
    "vue",
    "html",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "toml"
  ],
  "eslint.options": {
    "extensions": [
      ".ts",
      ".js",
      ".tsx",
      ".jsx",
      ".svelte",
      ".vue",
      ".json",
      ".jsonc",
      ".json5",
      ".html",
      ".yaml",
      ".yml",
      ".toml",
    ]
  },
  "[json]": {
    "editor.quickSuggestions": {
      "strings": true,
      "other": true
    },
    "editor.suggest.insertMode": "replace",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "git.confirmSync": false,
  "editor.suggestSelection": "first",
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "debug.console.wordWrap": false,
  "debug.console.fontSize": 12,
  "terminal.integrated.fontSize": 12,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "jest.runMode": "on-demand",
  "todo-tree.general.tags": [
    "FIXME",
    "FIX",
    "FIXIT",
    "TODO",
    "[ ]",
    "[x]"
  ],
  "todo-tree.filtering.excludeGlobs": [
    "**/node_modules",
    "**/dist",
    "**/out",
    "**/build",
    "**/vendor",
    "**/coverage",
    "**/packages"
  ],
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)[: $\n]",
  "todo-tree.regex.regexCaseSensitive": false,
  "todo-tree.tree.filterCaseSensitive": false,
  "todo-tree.general.tagGroups": {
    "FIXME": [
      "FIX",
      "FIXIT",
    ],
  },
  "todo-tree.highlights.customHighlight": {
    "FIXME": {
      "icon": "tools",
      "background": "#d41212",
      "foreground": "#fff",
      "iconColour": "#d41212"
    },
    "TODO": {
      "icon": "tasklist",
      "background": "#4C82EF",
      "foreground": "#fff",
      "iconColour": "#4C82EF"
    }
  },
  "[scss]": {
    "editor.defaultFormatter": "sibiraj-s.vscode-scss-formatter"
  },
  "workbench.colorCustomizations": {},
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "editor.stickyScroll.enabled": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.tabSize": 4
  },
  "oneDarkPro.bold": true,
  "yaml.schemas": {
    "file:///home/guido/.vscode/extensions/docsmsft.docs-yaml-1.0.4/dist/toc.schema.json": "/toc\\.yml/i"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "rapidapi.terminalLink.enabled": false,
  "todo-tree.general.statusBar": "tags",
  "workbench.iconTheme": "icons",
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "[One Dark Pro]": {
      "rules": {
        "*.readonly": {
          "underline": true,
        },
        "class": {
          "bold": true
        }
      }
    }
  },
  "workbench.startupEditor": "none",
  "editor.cursorBlinking": "expand",
  "editor.linkedEditing": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "explorer.compactFolders": false,
  "editor.renderWhitespace": "selection",
  "workbench.list.horizontalScrolling": true,
  "workbench.tree.indent": 20,
  "editor.bracketPairColorization.enabled": true,
  "workbench.colorTheme": "One Dark Pro Darker",
  "terminal.integrated.env.linux": {},
  "git.openRepositoryInParentFolders": "always",
  "[css]": {
    "editor.defaultFormatter": "sibiraj-s.vscode-scss-formatter"
  },
  "terminal.integrated.env.windows": {},
  "security.workspace.trust.untrustedFiles": "open",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.tree.enableStickyScroll": true,
  "tailwindCSS.experimental.classRegex": [
    "clsx`([^`]*)",
    "tw`([^`]*)",
    "/\\*\\s*tw\\s*\\*/\\s*`([^`]*)",
    [
      "tw.style\\(([^)]*)\\)",
      "'([^']*)'"
    ]
  ],
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "tw"
  ],
  "highlight-matching-tag.highlightFromContent": true,
  "highlight-matching-tag.highlightSelfClosing": true,
  "symbols.hidesExplorerArrows": false,
  "workbench.editor.enablePreview": false,
  "diffEditor.experimental.showMoves": true,
  "window.menuBarVisibility": "compact",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "README.md": "changelog.md, CODE_OF_CONDUCT.md, LICENSE.md",
    "build.gradle*": "gradlew*, gradle.properties, settings.gradle",
    ".gitignore": ".*ignore",
    "next.config.*": "next*",
  },
  "auto-close-tag.activationOnLanguage": [
    "astro",
    "xml",
    "php",
    "blade",
    "ejs",
    "jinja",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "plaintext",
    "markdown",
    "vue",
    "liquid",
    "erb",
    "lang-cfml",
    "cfml",
    "HTML (EEx)",
    "HTML (Eex)",
    "plist"
  ],
  "files.autoSave": "onFocusChange",
  "circleci.hostUrl": "",
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "javascript.inlayHints.parameterNames.enabled": "literals",
  "javascript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.inlayHints.parameterTypes.enabled": true,
  "javascript.inlayHints.enumMemberValues.enabled": true,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
  "javascript.inlayHints.propertyDeclarationTypes.enabled": true,
  "javascript.inlayHints.variableTypes.enabled": true,
  "editor.snippetSuggestions": "inline",
  "emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",
  "cSpell.userWords": [
    "Modarelli"
  ],
  "editor.detectIndentation": true,
  "zenMode.hideLineNumbers": false,
  "editor.minimap.enabled": false,
  "window.customTitleBarVisibility": "auto",
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [
      80
    ],
    "editor.selectionHighlight": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.renderSideBySide": true,
}