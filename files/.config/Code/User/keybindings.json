// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+alt+b a",
        "command": "bookmarks.listFromAllFiles"
    },
    {
        "key": "ctrl+alt+b l",
        "command": "bookmarks.list"
    },
    {
        "key": "alt+d",
        "command": "editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+alt+down",
        "command": "-editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+left",
        "command": "workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "ctrl+alt+-",
        "command": "-workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "alt+right",
        "command": "workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        "key": "ctrl+shift+-",
        "command": "-workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        "key": "ctrl+alt+b t",
        "command": "bookmarks.toggle",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+alt+k",
        "command": "-bookmarks.toggle",
        "when": "editorTextFocus"
    },
    {
        "key": "alt+.",
        "command": "-docs.write",
        "when": "false"
    },
    {
        "key": "meta+.",
        "command": "-docs.write",
        "when": "false"
    },
    {
        "key": "ctrl+.",
        "command": "-docs.write",
        "when": "false"
    },
    {
        "key": "alt+.",
        "command": "docs.write",
        "when": "editorTextFocus && editorLangId =~ /typescript|javascript|python|php|java|c|cpp|csharp|dart|ruby|go|rust/"
    },
    {
        "key": "alt+.",
        "command": "-docs.write",
        "when": "editorTextFocus && config.docwriter.hotkey.window == 'Alt + .' && editorLangId =~ /typescript|javascript|python|php|java|c|cpp|csharp|dart|ruby|go|rust/"
    },
    {
        "key": "ctrl+.",
        "command": "-docs.write",
        "when": "editorTextFocus && config.docwriter.hotkey.window == 'Ctrl + .' && editorLangId =~ /typescript|javascript|python|php|java|c|cpp|csharp|dart|ruby|go|rust/"
    },
    {
        "key": "shift+alt+delete",
        "command": "editor.emmet.action.removeTag"
    },
    {
        "key": "ctrl+i",
        "command": "-extension.wrapTag",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+w",
        "command": "editor.emmet.action.wrapWithAbbreviation"
    },
    {
        "key": "alt+w",
        "command": "editor.action.smartSelect.expand",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+right",
        "command": "-editor.action.smartSelect.expand",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+u",
        "command": "typescript.removeUnusedImports"
    },
    {
        "key": "shift+alt+u",
        "command": "javascript.removeUnusedImports"
    },
    {
        "key": "f9",
        "command": "workbench.action.debug.stepIntoTarget",
        "when": "inDebugMode && stepIntoTargetsSupported && debugState == 'stopped'"
    },
    {
        "key": "ctrl+f11",
        "command": "-workbench.action.debug.stepIntoTarget",
        "when": "inDebugMode && stepIntoTargetsSupported && debugState == 'stopped'"
    },
    {
        "key": "ctrl+shift+i",
        "command": "-supermaven.addToChat"
    },
    {
        "key": "f8",
        "command": "workbench.action.debug.continue",
        "when": "debugState == 'stopped'"
    },
    {
        "key": "f5",
        "command": "-workbench.action.debug.continue",
        "when": "debugState == 'stopped'"
    },
    {
        "key": "ctrl+shift+alt+e",
        "command": "editor.debug.action.selectionToRepl"
    },
    {
        "key": "f9",
        "command": "editor.debug.action.runToCursor"
    }
]
