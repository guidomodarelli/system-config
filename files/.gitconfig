[user]
    email = guidomodarelli25@gmail.com
    name = guidomodarelli25

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    max-line-length = 0

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[init]
    defaultBranch = main
