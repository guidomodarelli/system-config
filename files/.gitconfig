[user]
	email = guidomodarelli25@gmail.com
	name = Guido Modarelli
	signingkey = /home/guido/.ssh/id_ed25519.pub
[core]
	pager = delta
	autocrlf = false
[interactive]
	diffFilter = delta --color-only
[delta]
  navigate = true
  line-numbers = true
  max-line-length = 0
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /home/guido/.ssh/allowed_signers

