[user]
	email = guidomodarelli25@gmail.com
	name = guidomodarelli25
	signingkey = /home/guido/.ssh/id_rsa.pub
[core]
	autocrlf = input
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /home/guido/.config/git/allowed_signers
