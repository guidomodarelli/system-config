{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$defs": {
    "platform": {
      "type": "string",
      "enum": [
        "darwin",
        "linux",
        "win32"
      ]
    },
    "linuxDistro": {
      "type": "string",
      "enum": [
        "all",
        "arch",
        "debian"
      ],
      "description": "Linux distribution type",
      "$comment": "When this field is not present, it means that the configuration is applicable to all linux distributions",
      "default": "all"
    },
    "platformConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "linuxDistro": {
          "$ref": "#/$defs/linuxDistro"
        }
      },
      "required": ["platform"],
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": { "enum": ["linux"] }
            }
          },
          "then": {
            "properties": {
              "linuxDistro": { "$ref": "#/$defs/linuxDistro" }
            }
          },
          "else": {
            "not": {
              "required": ["linuxDistro"]
            }
          }
        }
      ]
    },
    "platformArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      },
      "uniqueItems": true
    },
    "platformConfigArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platformConfig"
      },
      "uniqueItems": true
    }
  },
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "unevaluatedProperties": false,
        "properties": {
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "onlyFor": {
            "$ref": "#/$defs/platformConfigArray"
          },
          "excludeFor": {
            "$ref": "#/$defs/platformConfigArray"
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "unevaluatedProperties": false,
              "properties": {
                "destination": {
                  "type": "string"
                }
              },
              "required": ["destination"],
              "allOf": [
                { "$ref": "#/$defs/platformConfig" }
              ]
            }
          }
        },
        "required": [
          "origin"
        ]
      }
    }
  }
}
